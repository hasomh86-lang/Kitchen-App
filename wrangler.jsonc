{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisan-kitchen",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "artisan-kitchen", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "REPLACE_WITH_YOUR_KV_ID" }
  ],
  "vars": {
    "APP_NAME": "Artisan Kitchen"
  },
  "observability": { "enabled": true }
}
