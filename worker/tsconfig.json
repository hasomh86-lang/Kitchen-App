{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@shared/*": ["shared/*"] }
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
